{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "workspace": {
    "name": "grv-ai-workspace",
    "description": "Plataforma interna de asistencia para desarrollo GRV"
  },
  "skills": {
    "autoload": true,
    "directories": [
      "skills/onboarding",
      "skills/domain",
      "skills/engineering",
      "skills/processes"
    ]
  },
  "agents": {
    "directory": "agents"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "command": "bash .claude/hooks/pre-edit-secrets.sh"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "command": "bash .claude/hooks/post-edit-migration-check.sh"
      },
      {
        "matcher": "Edit|Write",
        "command": "bash .claude/hooks/post-edit-api-sync.sh"
      },
      {
        "matcher": "Edit|Write",
        "command": "bash .claude/hooks/post-edit-test-check.sh"
      },
      {
        "matcher": "Edit|Write",
        "command": "bash .claude/hooks/post-edit-test-suggestion.sh"
      },
      {
        "matcher": "Edit|Write",
        "command": "bash .claude/hooks/post-edit-pii-in-logs.sh"
      },
      {
        "matcher": "Edit|Write",
        "command": "bash .claude/hooks/post-edit-changelog-suggest.sh"
      }
    ]
  },
  "context": {
    "directory": "context",
    "autoload": [
      "microservices.yaml",
      "team.yaml",
      "glossary.yaml"
    ]
  },
  "defaults": {
    "mariadb_environment": "dev",
    "require_explicit_prod_switch": true,
    "block_write_statements": true,
    "enforce_limit_on_select": true,
    "pii_warning": true
  }
}
