# =============================================================================
# grv-ai-workspace — variables de entorno
# =============================================================================
#
# Copiar este archivo a `.env` y completar con valores reales.
# NUNCA commitear el `.env` — está en `.gitignore`.
#
# El MCP de MariaDB se conecta vía SSE y necesita URL de conexión en env.
# Hasta que tengamos un usuario dedicado `claude_readonly`, usar un usuario
# existente de read-only o asegurar que las capas del skill validen queries
# (ver docs/mcp-setup.md).

# -----------------------------------------------------------------------------
# MariaDB — Development
# -----------------------------------------------------------------------------
# Ambiente por defecto para todas las operaciones de Claude.
GRV_MARIADB_DEV_HOST=localhost
GRV_MARIADB_DEV_PORT=3306
GRV_MARIADB_DEV_USER=your_readonly_user
GRV_MARIADB_DEV_PASSWORD=
GRV_MARIADB_DEV_DATABASE=grv_dev
GRV_MARIADB_DEV_READONLY=true

# -----------------------------------------------------------------------------
# MariaDB — Production
# -----------------------------------------------------------------------------
# SOLO lectura. Requiere acción explícita del usuario para usar este perfil.
# Claude nunca cambia a prod por su cuenta.
GRV_MARIADB_PROD_HOST=
GRV_MARIADB_PROD_PORT=3306
GRV_MARIADB_PROD_USER=your_readonly_user
GRV_MARIADB_PROD_PASSWORD=
GRV_MARIADB_PROD_DATABASE=grv_prod
GRV_MARIADB_PROD_READONLY=true

# Timeouts y límites (aplicados por el wrapper del skill)
GRV_MARIADB_MAX_EXECUTION_TIME_MS=5000
GRV_MARIADB_DEFAULT_LIMIT=1000
GRV_MARIADB_RATE_LIMIT_PER_MIN=20

# -----------------------------------------------------------------------------
# Context7 (docs actualizadas de libs)
# -----------------------------------------------------------------------------
CONTEXT7_API_KEY=

# -----------------------------------------------------------------------------
# Sentry (opcional, para deploy-post-mortem)
# -----------------------------------------------------------------------------
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# Granola (opcional, para granola-to-actions)
# -----------------------------------------------------------------------------
GRANOLA_API_KEY=

# -----------------------------------------------------------------------------
# GitLab (opcional, para integración con MRs)
# -----------------------------------------------------------------------------
GITLAB_URL=https://gitlab.grv.example
GITLAB_TOKEN=

# -----------------------------------------------------------------------------
# Workspace contribution skill
# -----------------------------------------------------------------------------
# Si está en true, el skill workspace-contribution hace git push automático
# al terminar de crear la rama. Por default es false: el commit queda local
# y el usuario hace push cuando quiere.
GRV_WORKSPACE_AUTO_PUSH=false
